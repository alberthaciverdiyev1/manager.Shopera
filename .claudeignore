# Dependencies
/vendor
/node_modules

# Build output
/public/build
/public/hot

# Laravel runtime
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*
